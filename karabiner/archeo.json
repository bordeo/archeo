{
  "title": "Archeo shortcuts for Google Chrome",
  "rules": [
    {
      "description": "Archeo: Arc-style shortcuts in Chrome",
      "manipulators": [
        {
          "type": "basic",
          "description": "Shift-Command-C copies the current Chrome URL with Archeo",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["command", "shift"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "x",
              "modifiers": ["left_command", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Left Control release finishes an active Archeo tab selection",
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "to_after_key_up": [
            {
              "key_code": "comma",
              "modifiers": ["left_control", "left_shift"]
            },
            {
              "set_variable": {
                "name": "archeo_switching",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Right Control release finishes an active Archeo tab selection",
          "from": {
            "key_code": "right_control",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_control"
            }
          ],
          "to_after_key_up": [
            {
              "key_code": "comma",
              "modifiers": ["left_control", "left_shift"]
            },
            {
              "set_variable": {
                "name": "archeo_switching",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Shift-Tab cycles backward through recent Chrome tabs with Archeo",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": ["control", "shift"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "archeo_switching",
                "value": 1
              }
            },
            {
              "key_code": "u",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Tab cycles through most-recent Chrome tabs with Archeo",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": ["control"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "archeo_switching",
                "value": 1
              }
            },
            {
              "key_code": "period",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Fn-J moves left when an Fn-J arrow layer is installed",
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": ["control", "fn"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "u",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "archeo_switching",
              "value": 1
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Fn-L moves right when an Fn-L arrow layer is installed",
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": ["control", "fn"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "period",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "archeo_switching",
              "value": 1
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Left Arrow moves left in an active Archeo tab selection",
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": ["control"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "u",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "archeo_switching",
              "value": 1
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Control-Right Arrow moves right in an active Archeo tab selection",
          "from": {
            "key_code": "right_arrow",
            "modifiers": {
              "mandatory": ["control"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "period",
              "modifiers": ["left_control", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "archeo_switching",
              "value": 1
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Command-Option-C keeps Chrome's element inspector available",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["command", "option"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": ["left_command", "left_shift"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.google\\.Chrome\\.(beta|dev|canary)$",
                "^org\\.chromium\\.Chromium$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
