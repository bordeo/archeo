{
  "manifest_version": 3,
  "name": "Archeo",
  "description": "A few of Arc's small, useful interactions for Chrome.",
  "version": "0.2.7",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "favicon",
    "offscreen",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Archeo",
    "default_popup": "popup.html"
  },
  "commands": {
    "copy-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Copy the current page link"
    },
    "switch-recent-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Switch through tabs by most recent use"
    },
    "switch-recent-tab-backward": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Switch backward through tabs by most recent use"
    },
    "commit-recent-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "MacCtrl+Shift+Comma"
      },
      "description": "Finish the recent-tab selection"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["key-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["grouping.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
